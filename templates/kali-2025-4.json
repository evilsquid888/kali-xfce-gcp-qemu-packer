{
	"variables": {
		"iso_url": "https://cdimage.kali.org/kali-2025.4/kali-linux-2025.4-installer-amd64.iso",
		"iso_checksum_type": "sha256",
		"iso_checksum": "3b4a3a9f5fb6532635800d3eda94414fb69a44165af6db6fa39c0bdae750c266",
		"public_key": null
	},
	"builders": [{
		"type": "qemu",
		"iso_url": "{{user `iso_url`}}",
		"iso_checksum_type": "{{user `iso_checksum_type`}}",
		"iso_checksum": "{{user `iso_checksum`}}",
		"headless": false,
		"http_directory": "{{template_dir}}/../http",
		"http_port_min": 9001,
		"http_port_max": 9001,
		"boot_wait": "3s",
		"boot_key_interval": "10ms",
		"boot_command": [
			"<esc><wait>",
			"install <wait>",
			"preseed/url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/preseed-2025-4.cfg ",
			"locale=en_US ",
			"keymap=us ",
			"hostname=kali ",
			"domain='' ",
			"<enter>"
		],
		"communicator": "ssh",
		"ssh_username": "root",
		"ssh_password": "toor",
		"ssh_wait_timeout": "2h",
		"accelerator": "kvm",
		"shutdown_command": "echo 'packer' | sudo -S shutdown -P now",
		"shutdown_timeout": "30m",
		"vm_name": "disk.raw",
		"disk_size": 20000,
		"format": "raw",
		"net_device": "virtio-net",
		"disk_interface": "virtio",
		"output_directory": "output",
		"qemuargs": [
	 		["-m", "4096"],
			["-smp", "2"],
			["-display", "gtk"]
		]
	}],
	"provisioners": [
		{
			"type": "shell",
			"inline_shebang": "/bin/bash",
			"inline": [
				"mkdir -p /root/.ssh",
				"touch /root/.ssh/authorized_keys",
				"chmod 700 /root/.ssh",
				"chmod 600 /root/.ssh/authorized_keys",
				"echo {{user `public_key`}} > /root/.ssh/authorized_keys",
				"sed -i 's/PermitRootLogin yes/PermitRootLogin without-password/' /etc/ssh/sshd_config"
			]
		},
		{
			"type": "shell",
			"inline_shebang": "/bin/bash",
			"inline": [
				"# Install google cloud environment",
				"",
				"rm /etc/hostname",
				"",
				"# Add Google Cloud apt repo (Kali 2025.4 is based on Debian bookworm)",
				"curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg",
				"DIST=bookworm",
				"sudo tee /etc/apt/sources.list.d/google-cloud.list << EOM",
				"deb [signed-by=/usr/share/keyrings/cloud.google.gpg] http://packages.cloud.google.com/apt google-compute-engine-${DIST}-stable main",
				"deb [signed-by=/usr/share/keyrings/cloud.google.gpg] http://packages.cloud.google.com/apt google-cloud-packages-archive-keyring-${DIST} main",
				"EOM",
				"",
				"sudo apt update",
				"",
				"# Install google packages",
				"# https://cloud.google.com/compute/docs/images/install-guest-environment#debian",
				"",
				"sudo apt install -y google-cloud-packages-archive-keyring",
				"sudo apt install -y google-compute-engine gce-disk-expand && systemctl enable google-disk-expand",
				"",
				"sudo systemctl enable google-startup-scripts.service",
				"sudo systemctl enable google-shutdown-scripts.service",
				"",
				"# Regenerate SSH host keys",
				"rm -f /etc/ssh/ssh_host_*",
				"dpkg-reconfigure openssh-server",
				"service ssh start",
				"service ssh reload",
				""
			]

		},
		{
			"type": "shell",
			"inline_shebang": "/bin/bash",
			"inline": [
				"sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=.*$/GRUB_CMDLINE_LINUX_DEFAULT=\"\"/' /etc/default/grub",
				"sed -i 's/GRUB_CMDLINE_LINUX=.*$/GRUB_CMDLINE_LINUX=\"console=tty0 console=ttyS0,38400n8d\"/' /etc/default/grub",
				"update-grub"
			]
		}
	],
	"post-processors": [
		[
			{
				"type": "compress",
				"output": "output/disk.raw.tar.gz"
			},
			{
				"type": "googlecompute-import",
				"account_file": "{{template_dir}}/../account.json",
				"project_id": "REPLACE_ME",
				"bucket": "REPLACE_ME",
				"image_name": "kali-rolling-{{timestamp}}",
				"image_family": "kali-rolling-gcpized"
			}
		]
	]
}
